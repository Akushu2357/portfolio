{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": ["eslint:recommended", "plugin:react-hooks/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "ignorePatterns": ["dist", "node_modules", ".prerender"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^[A-Z]",
        "argsIgnorePattern": "^_"
      }
    ]
  }
}
